# ==========================================
# Medsync Platform Environment Variables Template
# ==========================================

# 1. MongoDB Database (Use MongoDB Atlas for Production)
# Example: mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/healthcare_ai_demo?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=healthcare_ai_demo

# 2. JWT Security
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY_HOURS=12

# 3. AI / OCR Configuration
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# 4. URLs & Storage
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
